{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LeasePoliciesOnLeasableUsersOnly",
      "Effect": "Allow",
      "Action": ["iam:PutUserPolicy", "iam:DeleteUserPolicy", "iam:GetUserPolicy", "iam:ListUserPolicies"],
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:user/leasedesk/*"
    },
    {
      "Sid": "ListLeasableUsers",
      "Effect": "Allow",
      "Action": "iam:ListUsers",
      "Resource": "*"
    }
  ]
}
