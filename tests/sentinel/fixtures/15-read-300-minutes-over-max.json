{
  "name": "15-read-300-minutes-over-max",
  "proposal": {
    "kind": "lease_proposal",
    "version": 1,
    "requester_hint": "Arnab",
    "summary": "Read October invoice exports to debug the billing report",
    "justification": "Debugging ticket BILL-142; report totals are off",
    "duration_minutes": 300,
    "statements": [
      {
        "sid": "ReadInvoiceExports",
        "actions": [
          "s3:GetObject"
        ],
        "resources": [
          "arn:aws:s3:::leasedesk-demo-billing-abc123/exports/2026-10/*"
        ]
      },
      {
        "sid": "ListInvoiceExports",
        "actions": [
          "s3:ListBucket"
        ],
        "resources": [
          "arn:aws:s3:::leasedesk-demo-billing-abc123"
        ],
        "conditions": {
          "StringLike": {
            "s3:prefix": [
              "exports/2026-10/*"
            ]
          }
        }
      }
    ]
  },
  "expect": {
    "risk": "BLOCK",
    "rules": [
      "duration-over-max"
    ],
    "corrected_risk": "LOW"
  }
}
