# Copy to .env and fill in. .env is gitignored; keep it mode 600 (chmod 600 .env).

# Switch agent bridge base URL (find it with: uv run python scripts/spikes/health.py)
SWITCH_BASE_URL=http://localhost:PORT
# Registration key from the Gateway's API Keys page. Shown once. Never paste it in chat.
SWITCH_REGISTRATION_KEY=replace-me

# mock (moto, default) or real (sandbox AWS account via named profiles)
LEASEDESK_AWS_MODE=mock
LEASEDESK_AWS_REGION=us-east-1
LEASEDESK_KEYMASTER_PROFILE=leasedesk-keymaster
LEASEDESK_SENTINEL_PROFILE=leasedesk-sentinel
# Billed Access Analyzer custom checks (CheckNoNewAccess, CheckAccessNotGranted). Leave false.
# sentinel's crown-jewel check costs $0.002 per review and runs only in real mode with this on.
LEASEDESK_ENABLE_PAID_CHECKS=false
# The sandbox account leases are for. Required in real mode; mock mode uses moto's 123456789012.
# LEASEDESK_AWS_ACCOUNT_ID=

LEASEDESK_STATE_DIR=.state
LEASEDESK_SECRETS_DIR=.secrets
LEASEDESK_LOG_LEVEL=INFO

# keymaster (Part 2)
LEASEDESK_TZ=America/New_York
# document (read the person-written "access-policy" library doc) or file (switch/docs/access-policy.yaml)
LEASEDESK_POLICY_SOURCE=document
LEASEDESK_POLICY_DOC=access-policy
LEASEDESK_POLICY_FILE=switch/docs/access-policy.yaml
LEASEDESK_DB=.state/keymaster.db
LEASEDESK_MOTO_PORT=5055
# Written by `make register`: each agent's own message sender id. Outside dev mode, verdicts
# count only from LEASEDESK_SENTINEL_ID, and sentinel gives a gating verdict only to review
# requests from LEASEDESK_KEYMASTER_ID (everyone else gets advice).
# LEASEDESK_KEYMASTER_ID=
# LEASEDESK_SENTINEL_ID=
# Dev mode allows 3-minute leases and unpinned verdicts from agents. Demos only.
LEASEDESK_DEV_MODE=false
# DEV ONLY stand-in for sentinel: LOW, MEDIUM, HIGH or BLOCK. Refused in real mode. Leave it
# unset now that sentinel runs, or keymaster answers its own review requests.
# LEASEDESK_DEV_FAKE_VERDICT=LOW

# sentinel (Part 3). Reads the person-written "resource-catalog" doc (or the file when
# LEASEDESK_POLICY_SOURCE=file) next to access-policy.
LEASEDESK_CATALOG_DOC=resource-catalog
LEASEDESK_CATALOG_FILE=switch/docs/resource-catalog.md
LEASEDESK_SENTINEL_DB=.state/sentinel.db
